<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>SF PEG Record Map</masterLabel>
    <description>Map displaying addresses of current record</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property   name="cardTitle"
                        label="Card Title"
                        type="String"
                        default="Locations"
                        description="Title of the wrapping card" />
            <property   name="cardIcon"
                        label="Card Icon"
                        type="String"
                        default="standard:location"
                        description="Icon of the wrapping card" />
            <property   name="cardClass"
                        label="Card CSS"
                        type="String"
                        default="slds-card slds-card_boundary"
                        description="CSS of the wrapping card" />

            <property   name="location1"
                        label="Location #1"
                        type="String"
                        datasource="apex://sfpegAddressSelector_CTL"
                        description="Field providing the first Address in the current record." />
            <property   name="icon1"
                        label="Icon #1"
                        type="String"
                        default="standard:address"
                        description="Icon for the first Address." />
            <property   name="location2"
                        label="Location #2"
                        type="String"
                        datasource="apex://sfpegAddressSelector_CTL"
                        description="Field providing a second Address in the current record." />
            <property   name="icon2"
                        label="Icon #2"
                        type="String"
                        default="standard:address"
                        description="Icon for the second Address." />
            <property   name="location3"
                        label="Location #3"
                        type="String"
                        datasource="apex://sfpegAddressSelector_CTL"
                        description="Field providing a third Address in the current record." />
            <property   name="icon3"
                        label="Icon #3"
                        type="String"
                        default="standard:address"
                        description="Icon for the third Address." />
            <property   name="location4"
                        label="Location #4"
                        type="String"
                        datasource="apex://sfpegAddressSelector_CTL"
                        description="Field providing a fourth Address in the current record." />
            <property   name="icon4"
                        label="Icon #4"
                        type="String"
                        default="standard:address"
                        description="Icon for the fourth Address." />
            <property   name="location5"
                        label="Location #5"
                        type="String"
                        datasource="apex://sfpegAddressSelector_CTL"
                        description="Field providing a fifth Address in the current record." />
            <property   name="icon5"
                        label="Icon #5"
                        type="String"
                        default="standard:address"
                        description="Icon for the fifth Address." />

            <property   name="mapLegend"
                        label="Legend"
                        type="String"
                        description="Map legend" />

            <property   name="listView"
                        label="List View"
                        type="String"
                        default="auto"
                        datasource="visible,hidden,auto"
                        description="Display mode for the address side list view" />

            <property   name="draggable"
                        label="Draggable?"
                        type="Boolean"
                        default="true"
                        description="Enables dragging to pan the map with the mouse." />
            <property   name="zoomControl"
                        label="Zoom Control?"
                        type="Boolean"
                        default="true"
                        description="Shows the +/- zoom controls." />
            <property   name="scrollwheel"
                        label="Scroll with Wheel?"
                        type="Boolean"
                        default="false"
                        description="Permits zooming with the mouse wheel." />
            <property   name="disableDefaultUI"
                        label="Disable Default UI?"
                        type="Boolean"
                        default="false"
                        description="Remove Map/Satellite and +/- zoom buttons." />
            <property   name="disableDoubleClickZoom"
                        label="Disable 2-Clicks Zoom?"
                        type="Boolean"
                        default="false"
                        description="Disable zooming with a mouse double-click" />

            <property   name="isDebug"
                        label="Debug ?"
                        type="Boolean"
                        default="false"
                        description="Debug information activation" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>